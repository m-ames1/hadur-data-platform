{
  "duckdb.databases": [
    {
      "alias": "hadur",
      "type": "file",
      "path": "./hadur.duckdb",
      "readOnly": true,
      "attached": true
    },
    {
      "alias": "landing",
      "type": "file",
      "path": "./catalog/landing.duckdb",
      "readOnly": true,
      "attached": true
    },
    {
      "alias": "bronze",
      "type": "file",
      "path": "./catalog/bronze.duckdb",
      "readOnly": true,
      "attached": true
    }
  ],
  "duckdb.defaultDatabase": "hadur",
  "duckdb.resultsLocation": "beside",
  "duckdb.pageSize": 200,
  "duckdb.explorer.defaultRowLimit": 1000,
  "duckdb.format.keywordCase": "upper",
  "jupyter.notebookFileRoot": "${workspaceFolder}",
  "[sql]": {
    "editor.wordBasedSuggestions": "off"
  }
}
